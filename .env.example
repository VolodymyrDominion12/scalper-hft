# ─── Binance API (USDT-M futures) ────────────────────────────────────────────
# Скопіюй .env.example → .env і встав свої ключі. .env НІКОЛИ не коміть.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ─── Режим ───────────────────────────────────────────────────────────────────
# true = paper trading (testnet або симуляція), false = live ф'ючерси
DRY_RUN=true
# binance-testnet | binance (live) | binanceusdm (live без testnet)
EXCHANGE=binance-testnet

# ─── Витрати (Binance USDT-M стандарт, з BNB-дисконтом ~10%) ────────────────
MAKER_FEE=0.0002
TAKER_FEE=0.0005
# Прослизання в bps (0.0005 = 0.05% = 5 bps). Для скальпінгу критично.
SLIPPAGE_BPS=2.0
# Виконання за замовчуванням: true = post-only лімітні (maker) ордери
# (для carry/arb структур — maker-комісії обов'язкові, див. docs/funding_regimes.md)
MAKER_EXECUTION=true

# ─── Ризик ───────────────────────────────────────────────────────────────────
# Частка депозиту на одну позицію (0.01 = 1%)
POSITION_PCT=0.01
# Максимум одночасних позицій
MAX_OPEN_POSITIONS=1
# Денний ліміт збитків (% від стартового депозиту) — стоп на день
DAILY_LOSS_LIMIT=0.03
# Максимум послідовних збитків до паузи
MAX_CONSECUTIVE_LOSSES=3

# ─── Дані ───────────────────────────────────────────────────────────────────
DATA_DIR=./data
# Символи за замовчуванням через кому
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
DEFAULT_INTERVAL=1m
