# ─── Binance API (USDT-M futures) ────────────────────────────────────────────
# Скопіюй .env.example → .env і встав свої ключі. .env НІКОЛИ не коміть.
# На VPS тримай ОКРЕМИЙ .env (не копіюй з ноута). Деплой тегу його не перезаписує.
# Live ключі: IP whitelist лише VPS, futures trade, без withdraw.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ─── Режим ───────────────────────────────────────────────────────────────────
# true = paper trading (testnet або симуляція), false = live ф'ючерси
# На VPS paper-юніті лишай true. DRY_RUN=false — лише після Paper-Gate і явного рішення.
DRY_RUN=true
# binance (live public API) | binanceusdm | binance-testnet
# Для бектесту/paper — саме binance: testnet віддає СИНТЕТИЧНУ історію
# (ціни розходяться з ринком на 1–17%, рухи +27% за 1m, «плити» з нульовим
# обсягом) → фальшивий edge у sweep. Реальні ордери — лише DRY_RUN=false.
EXCHANGE=binance
# ─── Біржа для РИНКОВИХ ДАНИХ (klines/aggTrades/funding) ─────────────────────
# ОКРЕМО від EXCHANGE (торгівля). МУСИТЬ бути live: testnet віддає синтетичну
# історію (ціни розходяться з ринком на 1–17%, рухи +27% за 1m, «плити» з
# нульовим обсягом, funding обрізаний до ~13 міс) → фальшивий edge у sweep.
# Завантаження з testnet заблоковано; обхід (лише тести): ALLOW_TESTNET_DATA=true.
DATA_EXCHANGE=binanceusdm

# ─── Overfitting-аудит ───────────────────────────────────────────────────────
# «Замкований» holdout: останні N% історії не використовуються для підбору
# (WF/Optuna/sensitivity/DSR/CSCV) — лишаються для сліпого фінального тесту.
# 0 = вимкнено (exploratory). >0 обов'язкове для `overfit --mode final`.
HOLDOUT_PCT=0
# Fail-closed OOS-дисципліна: повторний аудит того самого вікна → error.
OOS_ENFORCE_BURN=false

# ─── Витрати (Binance USDT-M стандарт, з BNB-дисконтом ~10%) ────────────────
MAKER_FEE=0.0002
TAKER_FEE=0.0005
# Прослизання в bps (0.0005 = 0.05% = 5 bps). Для скальпінгу критично.
SLIPPAGE_BPS=2.0
# Виконання за замовчуванням: true = post-only лімітні (maker) ордери
# (для carry/arb структур — maker-комісії обов'язкові, див. docs/funding_regimes.md)
MAKER_EXECUTION=true

# ─── Ризик ───────────────────────────────────────────────────────────────────
# Частка депозиту на одну позицію (0.01 = 1%)
POSITION_PCT=0.01
# Максимум одночасних позицій
MAX_OPEN_POSITIONS=1
# Денний ліміт збитків (% від стартового депозиту) — стоп на день
DAILY_LOSS_LIMIT=0.03
# Peak-to-trough DD breaker: просідання від історичного піку equity → halt + авто-flatten
MAX_DRAWDOWN_PCT=0.10
# Жорсткий ліміт плеча: сумарний ноціонал позицій ≤ equity × MAX_LEVERAGE
MAX_LEVERAGE=3.0
# Vol-target sizing (paper pairs + векторний бектест через router):
# ENABLE_VOL_TARGET=true → ноціонал × clip(VOL_TARGET_ANN / realized σ, 0, 1).
# Дефолт false = фіксований PAIR_NOTIONAL_PCT / POSITION_PCT.
ENABLE_VOL_TARGET=false
VOL_TARGET_ANN=0.10
# Partial-fill resting maker-ордерів: cancel (дефолт) | wait
# PARTIAL_FILL_POLICY=cancel
# Максимум послідовних збитків до halt (після cooldown)
MAX_CONSECUTIVE_LOSSES=3
# Після N збитків — cooldown (size×0.5), не повний halt
COOLDOWN_LOSSES=2
COOLDOWN_HOURS=12
COOLDOWN_SIZE_MULT=0.5
# Кап суми PAIR_NOTIONAL_PCT пар, що ділять ногу (BTC-кластер)
CORR_NOTIONAL_CAP=0.40
# Тижневий ліміт збитків
WEEKLY_LOSS_LIMIT=0.06
# Paper pairs: ноціонал однієї ноги; сума по портфелю (3 пари → 20% кожна)
PAIR_NOTIONAL_PCT=0.30
PORTFOLIO_NOTIONAL_PCT=0.60
MAX_LOSING_MONTHS=2
# Скільки барів чекати post-only філл, перш ніж unfilled
MAKER_FILL_WAIT_BARS=1
# Seed P(fill|touch) для paper pairs і maker-бектесту (той самий → paper-audit).
# Зміна seed посеред paper-прогону скидає порівняння з BT — новий тег.
MAKER_FILL_SEED=42
# Hard-гейт overfitting-аудиту: live ЗАВЖДИ вимагає свіжий PASS.
# paper-run-pairs / PairsPaperRunner — fail-closed на комірку пари (LEG1/LEG2),
# незалежно від цього прапорця. REQUIRE_AUDIT_PASS лишається для інших шляхів.
REQUIRE_AUDIT_PASS=false
# Максимальний вік PASS-вердикта (діб), старший — переаудіт
AUDIT_MAX_AGE_DAYS=30

# ─── Дані ───────────────────────────────────────────────────────────────────
DATA_DIR=./data
# Символи за замовчуванням через кому
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,LINKUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,NEARUSDT,DOTUSDT,ATOMUSDT,UNIUSDT,LTCUSDT,AAVEUSDT
DEFAULT_INTERVAL=1m

# ─── Кеш даних: parquet (файли у DATA_DIR) або postgres (PostgreSQL у Docker) ──
# DATA_BACKEND=parquet
# Для PostgreSQL: `docker compose up -d postgres` (або `docker compose up -d` разом з pgAdmin):
# DATA_BACKEND=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5436
# POSTGRES_DB=scalper
# POSTGRES_USER=scalper
# POSTGRES_PASSWORD=your_strong_password_here
# (або повний DSN: POSTGRES_DSN=host=localhost port=5436 dbname=scalper user=scalper password=scalper)
#
# pgAdmin (http://localhost:5050):
# PGADMIN_PORT=5050
# PGADMIN_DEFAULT_EMAIL=admin@scalper.local
# PGADMIN_DEFAULT_PASSWORD=scalper

# ─── Telegram (опційно; без ключів send — no-op) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram Bot — whitelist chat_id через кому (хто може надсилати команди)
# Знайти свій chat_id: надіслати /start до @userinfobot
TELEGRAM_ALLOWED_CHAT_IDS=
# PIN для деструктивних команд бота (/pause, /resume)
# Порожнє → деструктивні команди вимкнені
TELEGRAM_BOT_PIN=

# ─── Dashboard (Streamlit) ───────────────────────────────────────────────────
# bcrypt-хеш пароля. Порожнє = без логіну лише на localhost (127.0.0.1).
# На VPS (DASHBOARD_HOST=0.0.0.0) пароль ОБОВ'ЯЗКОВИЙ.
# Згенерувати: uv run python -m scalper_hft.cli dashboard-hash
DASHBOARD_PASSWORD_HASH=
# DASHBOARD_HOST=127.0.0.1

# ─── FastAPI (cli api start) ─────────────────────────────────────────────────
# CLI `--host`/`--port` override these. Default bind is 0.0.0.0:8000.
# API_HOST=127.0.0.1
# API_PORT=8080
# Comma-separated CORS origins (never use * with credentials). Defaults: localhost dashboard+API.
# API_CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
# JWT signing key for `api token` / Authorization: Bearer. Required on non-localhost bind.
# API_SECRET_KEY=
# Dev-only: mock positions and destructive ops (flatten/close) via REST API
# API_ALLOW_MOCK_POSITIONS=false
# API_ALLOW_DESTRUCTIVE_OPS=false
