# ─── Binance API (USDT-M futures) ────────────────────────────────────────────
# Скопіюй .env.example → .env і встав свої ключі. .env НІКОЛИ не коміть.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ─── Режим ───────────────────────────────────────────────────────────────────
# true = paper trading (testnet або симуляція), false = live ф'ючерси
DRY_RUN=true
# binance-testnet | binance (live) | binanceusdm (live без testnet)
EXCHANGE=binance-testnet

# ─── Витрати (Binance USDT-M стандарт, з BNB-дисконтом ~10%) ────────────────
MAKER_FEE=0.0002
TAKER_FEE=0.0005
# Прослизання в bps (0.0005 = 0.05% = 5 bps). Для скальпінгу критично.
SLIPPAGE_BPS=2.0
# Виконання за замовчуванням: true = post-only лімітні (maker) ордери
# (для carry/arb структур — maker-комісії обов'язкові, див. docs/funding_regimes.md)
MAKER_EXECUTION=true

# ─── Ризик ───────────────────────────────────────────────────────────────────
# Частка депозиту на одну позицію (0.01 = 1%)
POSITION_PCT=0.01
# Максимум одночасних позицій
MAX_OPEN_POSITIONS=1
# Денний ліміт збитків (% від стартового депозиту) — стоп на день
DAILY_LOSS_LIMIT=0.03
# Максимум послідовних збитків до halt (після cooldown)
MAX_CONSECUTIVE_LOSSES=3
# Після N збитків — cooldown (size×0.5), не повний halt
COOLDOWN_LOSSES=2
COOLDOWN_HOURS=12
COOLDOWN_SIZE_MULT=0.5
# Кап суми PAIR_NOTIONAL_PCT пар, що ділять ногу (BTC-кластер)
CORR_NOTIONAL_CAP=0.40
# Тижневий ліміт збитків
WEEKLY_LOSS_LIMIT=0.06
# Paper pairs: ноціонал однієї ноги; сума по портфелю (3 пари → 20% кожна)
PAIR_NOTIONAL_PCT=0.30
PORTFOLIO_NOTIONAL_PCT=0.60
MAX_LOSING_MONTHS=2
# Скільки барів чекати post-only філл, перш ніж unfilled
MAKER_FILL_WAIT_BARS=1

# ─── Дані ───────────────────────────────────────────────────────────────────
DATA_DIR=./data
# Символи за замовчуванням через кому
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,LINKUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,NEARUSDT,DOTUSDT,ATOMUSDT,UNIUSDT,LTCUSDT,AAVEUSDT
DEFAULT_INTERVAL=1m

# ─── Кеш даних: parquet (файли у DATA_DIR) або postgres (PostgreSQL у Docker) ──
# DATA_BACKEND=parquet
# Для PostgreSQL: `docker compose up -d postgres` (або `docker compose up -d` разом з pgAdmin):
# DATA_BACKEND=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5436
# POSTGRES_DB=scalper
# POSTGRES_USER=scalper
# POSTGRES_PASSWORD=scalper
# (або повний DSN: POSTGRES_DSN=host=localhost port=5436 dbname=scalper user=scalper password=scalper)
#
# pgAdmin (http://localhost:5050):
# PGADMIN_PORT=5050
# PGADMIN_DEFAULT_EMAIL=admin@scalper.local
# PGADMIN_DEFAULT_PASSWORD=scalper

# ─── Telegram (опційно; без ключів send — no-op) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
