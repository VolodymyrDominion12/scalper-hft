# Профіль: VPS paper-pairs (без секретів).
# Скопіюй на сервер як .env; заповни ключі локально на VPS. Не коміть .env.
# Деплой git-тегом не перезаписує .env. Див. docs/DEPLOY_PLAN.md.

DRY_RUN=true
EXCHANGE=binance-testnet
DATA_EXCHANGE=binanceusdm

# Бот не використовує holdout; залишено для узгодженості з research
HOLDOUT_PCT=0
OOS_ENFORCE_BURN=false

MAKER_FEE=0.0002
TAKER_FEE=0.0005
SLIPPAGE_BPS=2.0
VOL_AWARE_SLIPPAGE_REF=0.0
MAKER_FILL_SEED=42
MAKER_EXECUTION=true

POSITION_PCT=0.01
# ROADMAP Paper-Gate: vol-target увімкнено на VPS (разом з paper-v0.2.0+)
ENABLE_VOL_TARGET=true
VOL_TARGET_ANN=0.10
PAIR_NOTIONAL_PCT=0.30
PORTFOLIO_NOTIONAL_PCT=0.60

REQUIRE_AUDIT_PASS=true
USE_EXIT_LADDERS=false

API_HOST=127.0.0.1
API_PORT=8000

DATA_DIR=./data
