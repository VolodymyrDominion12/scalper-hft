# Профіль: локальна research-машина (без секретів).
# Скопіюй у .env і додай BINANCE_API_KEY/SECRET за потреби (лише для download).
# НЕ копіюй цей файл на VPS — використовуй docs/env/vps-paper.env.example.

DRY_RUN=true
EXCHANGE=binance
DATA_EXCHANGE=binanceusdm

# Exploratory research: holdout вимкнено; увімкни перед final-аудитом
HOLDOUT_PCT=0
OOS_ENFORCE_BURN=false

MAKER_FEE=0.0002
TAKER_FEE=0.0005
SLIPPAGE_BPS=2.0
VOL_AWARE_SLIPPAGE_REF=0.0
MAKER_FILL_SEED=42
MAKER_EXECUTION=true

POSITION_PCT=0.01
ENABLE_VOL_TARGET=false
PAIR_NOTIONAL_PCT=0.30
PORTFOLIO_NOTIONAL_PCT=0.60

REQUIRE_AUDIT_PASS=false
USE_EXIT_LADDERS=false

API_HOST=127.0.0.1
API_PORT=8000

DATA_DIR=./data
