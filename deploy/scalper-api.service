[Unit]
Description=Scalper HFT FastAPI Server
After=network.target

[Service]
User=scalper
Group=scalper
WorkingDirectory=/opt/scalper-hft
EnvironmentFile=/opt/scalper-hft/.env
Environment="PATH=/opt/scalper-hft/.venv/bin"
# DRY_RUN=true за замовчуванням на рівні сервісу для безпеки, можна перевизначити в .env
Environment="DRY_RUN=true"
# API_HOST/API_PORT з .env (дефолт 127.0.0.1 — не публікувати без API_SECRET_KEY ≥32)
ExecStart=/bin/bash -c 'exec /opt/scalper-hft/.venv/bin/uvicorn scalper_hft.api.server:app --host ${API_HOST:-127.0.0.1} --port ${API_PORT:-8000}'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
